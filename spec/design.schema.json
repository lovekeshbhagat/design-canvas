{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design.schema.json",
  "title": "design.json",
  "description": "One app's design system in a standard shape, written by an agent from the app's code. See DESIGN_JSON.md.",
  "type": "object",
  "required": ["version", "app", "roles", "colors"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "app": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "platform": { "enum": ["react-native", "ios", "android", "flutter", "web", "other"] },
        "root": { "type": "string", "description": "App repo root, relative to the folder holding design.json. Default '..'." },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "device": { "enum": ["phone", "browser", "none"] },
            "width": { "type": "number", "minimum": 100 },
            "height": { "type": "number", "minimum": 100 }
          }
        }
      }
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string" },
          "scheme": { "enum": ["light", "dark"] }
        }
      }
    },
    "roles": {
      "type": "object",
      "required": ["background", "text"],
      "additionalProperties": false,
      "properties": {
        "background": { "type": "string" },
        "surface": { "type": "string" },
        "surface2": { "type": "string" },
        "text": { "type": "string" },
        "textMuted": { "type": "string" },
        "accent": { "type": "string" },
        "onAccent": { "type": "string" },
        "border": { "type": "string" },
        "danger": { "type": "string" },
        "scrim": { "type": "string" }
      }
    },
    "colors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/colorValue" },
          {
            "allOf": [
              { "$ref": "#/$defs/meta" },
              {
                "type": "object",
                "required": ["value"],
                "properties": {
                  "value": { "$ref": "#/$defs/colorValue" },
                  "on": {
                    "description": "The colour token(s) this colour is read on, for the contrast check: a name, a list of names, or one of those per theme id.",
                    "oneOf": [
                      { "$ref": "#/$defs/tokenNames" },
                      { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/tokenNames" } }
                    ]
                  },
                  "text": { "type": "boolean", "description": "true: check this colour's contrast as text; false: never. Only needed when the name and roles get it wrong." }
                }
              }
            ]
          }
        ]
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["family"],
        "properties": {
          "family": { "type": "string" },
          "weight": { "type": "integer", "minimum": 100, "maximum": 1000 },
          "style": { "enum": ["normal", "italic"] },
          "load": { "enum": ["google", "url", "system"] },
          "url": { "type": "string" },
          "code": { "$ref": "#/$defs/codeName" },
          "doc": { "type": "string" },
          "src": { "$ref": "#/$defs/srcLine" },
          "derived": { "type": "string" }
        }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": {
        "allOf": [
          { "$ref": "#/$defs/meta" },
          {
            "type": "object",
            "required": ["font", "size"],
            "properties": {
              "font": { "type": "string", "description": "A key in fonts." },
              "size": { "type": "number" },
              "lineHeight": { "type": "number", "description": "px. Leave out (with lineHeightRatio) when the code sets none: the platform default is used." },
              "lineHeightRatio": { "type": "number", "description": "Only when the code gives the line height as a multiple of the size." },
              "letterSpacing": { "type": "number", "description": "px" },
              "textTransform": { "enum": ["none", "uppercase", "lowercase", "capitalize"] },
              "sample": { "type": "string" }
            }
          }
        ]
      }
    },
    "spacing": { "$ref": "#/$defs/numberTokens" },
    "radii": { "$ref": "#/$defs/numberTokens" },
    "shadows": {
      "type": "object",
      "additionalProperties": {
        "allOf": [
          { "$ref": "#/$defs/meta" },
          {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "blur": { "type": "number" },
              "radius": { "type": "number", "description": "For code that writes a shadow radius (SwiftUI, UIKit): about half the CSS blur. When blur is left out, blur = 2 x radius." },
              "spread": { "type": "number" },
              "color": { "type": "string" },
              "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
              "elevation": { "type": "number" }
            }
          }
        ]
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durations": { "$ref": "#/$defs/numberTokens", "description": "Milliseconds. The drift check also accepts the value in seconds (value / 1000) in the code." },
        "easings": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "allOf": [{ "$ref": "#/$defs/meta" }, { "type": "object", "required": ["value"], "properties": { "value": { "type": "string" } } }] }
            ]
          }
        },
        "springs": {
          "type": "object",
          "additionalProperties": {
            "allOf": [
              { "$ref": "#/$defs/meta" },
              {
                "type": "object",
                "properties": {
                  "damping": { "type": "number" },
                  "stiffness": { "type": "number" },
                  "mass": { "type": "number", "description": "Default 1." },
                  "response": { "type": "number", "exclusiveMinimum": 0, "description": "SwiftUI .spring(response:dampingFraction:), seconds. stiffness = (2pi / response)^2 x mass." },
                  "dampingFraction": { "type": "number", "minimum": 0, "description": "SwiftUI. damping = 4pi x dampingFraction x mass / response." },
                  "duration": { "type": "number", "exclusiveMinimum": 0, "description": "SwiftUI .spring(duration:bounce:), seconds. Used as response." },
                  "bounce": { "type": "number", "exclusiveMinimum": -1, "maximum": 1, "description": "SwiftUI. dampingFraction = 1 - bounce (or 1 / (1 + bounce) below 0)." }
                }
              }
            ]
          }
        }
      }
    },
    "icons": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "set": { "type": "string" },
        "style": { "enum": ["stroke", "fill"] },
        "strokeWidth": { "type": "number" },
        "viewBox": { "type": "string" },
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "anyOf": [{ "required": ["svg"] }, { "required": ["system"] }],
            "additionalProperties": false,
            "properties": {
              "svg": { "type": "string" },
              "system": { "type": "string", "description": "An operating-system icon set (sf-symbols, material-symbols…). Drawn as a labelled placeholder instead of svg." },
              "name": { "type": "string", "description": "With system: the symbol's name, if it differs from the item key." },
              "source": { "type": "string" },
              "style": { "enum": ["stroke", "fill"] },
              "strokeWidth": { "type": "number" },
              "viewBox": { "type": "string" }
            }
          }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "importFrom": { "type": "array", "items": { "type": "string" } },
        "scan": { "type": "array", "items": { "type": "string" } },
        "ignore": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "tokenNames": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "hexOrRgba": { "type": "string", "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\(.*\\)|transparent)$" },
    "colorValue": {
      "oneOf": [
        { "$ref": "#/$defs/hexOrRgba" },
        { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/hexOrRgba" }, "description": "One value per theme id." }
      ]
    },
    "meta": {
      "type": "object",
      "properties": {
        "doc": { "type": "string" },
        "group": { "type": "string" },
        "code": { "$ref": "#/$defs/codeName" },
        "src": { "$ref": "#/$defs/srcLine" },
        "derived": { "type": "string", "description": "How the value is computed, when the code computes it instead of writing it. Never a way to silence drift." }
      }
    },
    "codeName": {
      "description": "How the code refers to the token, or one name per theme id: {\"light\": \"Palette.sand\", \"dark\": \"Palette.slate\"}.",
      "oneOf": [
        { "type": "string" },
        { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      ]
    },
    "srcLine": {
      "description": "path/from/app/root:line (several, comma-separated), or one per theme id.",
      "oneOf": [
        { "type": "string" },
        { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      ]
    },
    "numberTokens": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "number" },
          { "allOf": [{ "$ref": "#/$defs/meta" }, { "type": "object", "required": ["value"], "properties": { "value": { "type": "number" } } }] }
        ]
      }
    }
  }
}
